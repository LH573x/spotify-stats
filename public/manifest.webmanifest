{
  "name": "Meu Spotify",
  "short_name": "Meu Spotify",
  "description": "Seu histórico do Spotify, do começo até hoje.",
  "lang": "pt-BR",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#121212",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            ".zip",
            ".json",
            "application/zip",
            "application/x-zip-compressed",
            "application/x-zip",
            "application/octet-stream",
            "application/json"
          ]
        }
      ]
    }
  }
}
